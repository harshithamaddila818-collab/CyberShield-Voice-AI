# Copy this file to ".env" in the project root and fill in your keys.
GNANI_API_KEY=your_gnani_api_key
GEMINI_API_KEY=your_gemini_api_key

# Gemini model (free-tier availability changes; check Google AI Studio)
GEMINI_MODEL=gemini-3.5-flash-lite
# Models tried in order if the first is busy, retired (404) or out of quota
GEMINI_FALLBACK_MODELS=gemini-2.5-flash
# Max seconds to wait for Gemini (minimum 10)
GEMINI_TIMEOUT_SECONDS=12
# Connect to Gemini over IPv4 only (fixes ~100 s hangs on some networks)
GEMINI_FORCE_IPV4=true
# Set to false to run with the rule engine only (no Gemini calls, no quota used)
GEMINI_ENABLED=true

# Optional: Gnani voices
# GNANI_TTS_TELUGU_VOICE=Suhana
# GNANI_TTS_ENGLISH_VOICE=Kaveri
